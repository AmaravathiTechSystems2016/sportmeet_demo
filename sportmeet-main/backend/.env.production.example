# SportMeet production environment template

# Core Django
DJANGO_DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=sportmeet.example.com,api.sportmeet.example.com
CSRF_TRUSTED_ORIGINS=https://sportmeet.example.com,https://api.sportmeet.example.com
CORS_ALLOWED_ORIGINS=https://sportmeet.example.com

# Database - recommended for production
DB_ENGINE=postgresql
DB_NAME=sportmeet
DB_USER=sportmeet
DB_PASSWORD=replace-with-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# Email / SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=AUD

# Optional integrations
MAPBOX_TOKEN=replace-if-backend-geocoding-is-added
